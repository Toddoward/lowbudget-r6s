{
 "type": "object",
 "title": "소품",
 "properties": {
  "$schema": {
   "type": "string",
   "title": "스키마"
  },
  "props": {
   "type": "array",
   "title": "소품",
   "items": {
    "type": "object",
    "title": "소품",
    "properties": {
     "note": {
      "type": "string",
      "title": "메모",
      "description": "설명 (게임은 읽지 않음)"
     },
     "group": {
      "type": "string",
      "title": "묶음 메모",
      "description": "이 항목부터 시작하는 묶음의 설명 (게임은 읽지 않음)"
     },
     "type": {
      "type": "string",
      "title": "이름"
     },
     "floor": {
      "type": "integer",
      "title": "층",
      "description": "-1 = B (지하), 0 = 1F, 1 = 2F",
      "enum": [
       -1,
       0,
       1
      ]
     },
     "x": {
      "type": "number",
      "title": "중심 x (m)"
     },
     "z": {
      "type": "number",
      "title": "중심 z (m)"
     },
     "size": {
      "type": "array",
      "title": "크기 [x, y, z] (m)",
      "items": {
       "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
     },
     "mat": {
      "type": "string",
      "title": "재질",
      "description": "탄 관통: fabric·wood 관통, metal·vehicle·concrete 막음"
     },
     "color": {
      "type": "string",
      "title": "색",
      "description": "#rrggbb 또는 #rgb",
      "pattern": "^#([0-9a-fA-F]{3}){1,2}$"
     },
     "style": {
      "type": "string",
      "title": "모양"
     },
     "lift": {
      "type": "number",
      "title": "바닥에서 띄움 (m)"
     },
     "rot90": {
      "type": "boolean",
      "title": "긴 축을 X로"
     }
    },
    "additionalProperties": false,
    "required": [
     "type",
     "floor",
     "x",
     "z",
     "size",
     "mat",
     "color"
    ]
   }
  }
 },
 "additionalProperties": false,
 "description": "data/maps/house/props.json — 가구·엄폐물",
 "required": [
  "props"
 ],
 "$id": "props",
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}
