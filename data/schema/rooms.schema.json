{
 "type": "object",
 "title": "방",
 "properties": {
  "$schema": {
   "type": "string",
   "title": "스키마"
  },
  "rooms": {
   "type": "array",
   "title": "방",
   "items": {
    "type": "object",
    "title": "방",
    "properties": {
     "note": {
      "type": "string",
      "title": "메모",
      "description": "설명 (게임은 읽지 않음)"
     },
     "group": {
      "type": "string",
      "title": "묶음 메모",
      "description": "이 항목부터 시작하는 묶음의 설명 (게임은 읽지 않음)"
     },
     "id": {
      "type": "string",
      "title": "ID"
     },
     "name": {
      "type": "string",
      "title": "이름"
     },
     "floor": {
      "type": "integer",
      "title": "층",
      "description": "-1 = B (지하), 0 = 1F, 1 = 2F",
      "enum": [
       -1,
       0,
       1
      ]
     },
     "rects": {
      "type": "array",
      "title": "영역",
      "items": {
       "type": "object",
       "title": "사각형 (m)",
       "properties": {
        "x0": {
         "type": "number",
         "title": "서쪽 x"
        },
        "z0": {
         "type": "number",
         "title": "북쪽 z"
        },
        "x1": {
         "type": "number",
         "title": "동쪽 x"
        },
        "z1": {
         "type": "number",
         "title": "남쪽 z"
        }
       },
       "additionalProperties": false,
       "description": "월드 좌표 (m): +X 동쪽, +Z 남쪽",
       "required": [
        "x0",
        "z0",
        "x1",
        "z1"
       ]
      }
     },
     "transit": {
      "type": "boolean",
      "title": "통로 (스폰·목표 없음)"
     },
     "spot": {
      "type": "array",
      "title": "목표 지점 [x, z]",
      "items": {
       "type": "number"
      },
      "description": "인질·폭탄 위치",
      "minItems": 2,
      "maxItems": 2
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "floor",
     "rects",
     "spot"
    ]
   }
  }
 },
 "additionalProperties": false,
 "description": "data/maps/house/rooms.json",
 "required": [
  "rooms"
 ],
 "$id": "rooms",
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}
