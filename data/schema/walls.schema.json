{
 "type": "object",
 "title": "벽",
 "properties": {
  "$schema": {
   "type": "string",
   "title": "스키마"
  },
  "walls": {
   "type": "array",
   "title": "벽",
   "items": {
    "type": "object",
    "title": "벽",
    "properties": {
     "note": {
      "type": "string",
      "title": "메모",
      "description": "설명 (게임은 읽지 않음)"
     },
     "group": {
      "type": "string",
      "title": "묶음 메모",
      "description": "이 항목부터 시작하는 묶음의 설명 (게임은 읽지 않음)"
     },
     "floor": {
      "type": "integer",
      "title": "층",
      "description": "-1 = B (지하), 0 = 1F, 1 = 2F",
      "enum": [
       -1,
       0,
       1
      ]
     },
     "run": {
      "type": "string",
      "title": "방향",
      "description": "'x': z = c에서 x를 따라 · 'z': x = c에서 z를 따라",
      "enum": [
       "x",
       "z"
      ]
     },
     "c": {
      "type": "number",
      "title": "고정 좌표 (m)"
     },
     "from": {
      "type": "number",
      "title": "시작 (m)"
     },
     "to": {
      "type": "number",
      "title": "끝 (m)"
     },
     "tier": {
      "type": "string",
      "title": "재질 등급",
      "description": "solid: 파괴 불가 · soft: 부서지는 벽 · semi: 구멍만 나고 기둥은 남음",
      "enum": [
       "solid",
       "soft",
       "semi"
      ]
     },
     "ext": {
      "type": "boolean",
      "title": "외벽"
     },
     "t": {
      "type": "number",
      "title": "두께 덮어쓰기 (m)"
     },
     "h": {
      "type": "number",
      "title": "높이 덮어쓰기 (m)"
     },
     "openings": {
      "type": "array",
      "title": "문·창",
      "items": {
       "type": "object",
       "title": "개구부",
       "properties": {
        "at": {
         "type": "number",
         "title": "중심 위치 (m)",
         "description": "벽이 놓인 축을 따라"
        },
        "w": {
         "type": "number",
         "title": "폭 (m)"
        },
        "kind": {
         "type": "string",
         "title": "종류",
         "enum": [
          "door",
          "exterior_door",
          "window",
          "french",
          "open_window",
          "arch",
          "shutter",
          "vent"
         ]
        },
        "y0": {
         "type": "number",
         "title": "아래턱 높이 덮어쓰기 (m)"
        },
        "h": {
         "type": "number",
         "title": "높이 덮어쓰기 (m)"
        },
        "barricade": {
         "type": "boolean",
         "title": "바리케이드 가능 덮어쓰기"
        }
       },
       "additionalProperties": false,
       "required": [
        "at",
        "w",
        "kind"
       ]
      }
     },
     "spans": {
      "type": "array",
      "title": "다른 재질 구간",
      "items": {
       "type": "object",
       "title": "구간",
       "properties": {
        "from": {
         "type": "number",
         "title": "시작 (m)"
        },
        "to": {
         "type": "number",
         "title": "끝 (m)"
        },
        "tier": {
         "type": "string",
         "title": "재질 등급",
         "description": "solid: 파괴 불가 · soft: 부서지는 벽 · semi: 구멍만 나고 기둥은 남음",
         "enum": [
          "solid",
          "soft",
          "semi"
         ]
        }
       },
       "additionalProperties": false,
       "required": [
        "from",
        "to",
        "tier"
       ]
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "floor",
     "run",
     "c",
     "from",
     "to",
     "tier"
    ]
   }
  },
  "diagonal": {
   "type": "array",
   "title": "사선 외벽",
   "items": {
    "type": "object",
    "title": "사선 외벽",
    "properties": {
     "floor": {
      "type": "integer",
      "title": "층",
      "description": "-1 = B (지하), 0 = 1F, 1 = 2F",
      "enum": [
       -1,
       0,
       1
      ]
     },
     "a": {
      "type": "array",
      "title": "시작 [x, z]",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "b": {
      "type": "array",
      "title": "끝 [x, z]",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "window": {
      "type": "object",
      "title": "창",
      "properties": {
       "at": {
        "type": "number",
        "title": "위치 (0~1)"
       },
       "w": {
        "type": "number",
        "title": "폭 (m)"
       },
       "y0": {
        "type": "number",
        "title": "아래턱 (m)"
       },
       "h": {
        "type": "number",
        "title": "높이 (m)"
       },
       "barricade": {
        "type": "boolean",
        "title": "바리케이드 가능"
       }
      },
      "additionalProperties": false,
      "required": [
       "at",
       "w"
      ]
     }
    },
    "additionalProperties": false,
    "required": [
     "floor",
     "a",
     "b"
    ]
   }
  }
 },
 "additionalProperties": false,
 "description": "data/maps/house/walls.json — 축 정렬 벽과 사선 외벽",
 "required": [
  "walls",
  "diagonal"
 ],
 "$id": "walls",
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}
