{
  "name": "r6s-temu-web",
  "private": true,
  "version": "1.0.0",
  "description": "Rainbow Six Siege: Original 2015 Edition (Web Tactical FPS) - fan-made low-poly tactical FPS for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev -c worker/wrangler.toml --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "preview": "vite preview",
    "test": "node --experimental-transform-types --no-warnings tools/tests/run-tests.ts",
    "assets:spec": "node --experimental-strip-types --no-warnings tools/cli-anything/export-specs.ts",
    "assets:blender": "npm run assets:spec && python3 tools/cli-anything/pipeline.py",
    "deploy:worker": "wrangler deploy -c worker/wrangler.toml",
    "deploy:pages": "wrangler pages deploy dist --project-name r6s-temu",
    "deploy": "npm run build && npm run deploy:worker && npm run deploy:pages",
    "test:e2e": "node tools/tests/e2e.mjs",
    "agent:example": "node tools/agents/webmcp-playwright-agent.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.152.0"
  }
}
